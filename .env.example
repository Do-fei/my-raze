# =============================================================================
# my-raze — environment variables (template)
# Copy to `.env` and fill in real values. `.env` is gitignored per developer.
#
# Auth: ADR 0006 (Better-Auth + email magic-link). Phase 1b-ii.1.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# `development` enables Vite middleware mode. Anything else is treated as prod.
NODE_ENV=development
# Port the unified Express + Vite server listens on.
PORT=3000

# --- Database -----------------------------------------------------------------
# MySQL 8 connection string. Local dev uses the docker container created by
# `docker run -d --name my-raze-mysql -e MYSQL_ROOT_PASSWORD=devpass \
#   -e MYSQL_DATABASE=myraze -p 3306:3306 mysql:8`.
DATABASE_URL=mysql://root:devpass@127.0.0.1:3306/myraze

# --- Auth ---------------------------------------------------------------------
# Cookie/JWT signing secret. MUST be a random ≥32-char string in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-locally-then-rotate-in-production

# Master secret used to encrypt per-user BYOK API keys at rest
# (`server/_core/encryption.ts`). MUST be ≥32 chars and MUST be different
# from JWT_SECRET. Generate a SECOND random hex with: openssl rand -hex 32
KEY_ENCRYPTION_KEY=change-me-to-a-different-secret-than-jwt

# (Legacy) If set, this openId is auto-promoted to admin on first login.
# OWNER_OPEN_ID=

# --- Email (Phase 1b-ii.1 / ADR 0006) ----------------------------------------
# In production, you MUST configure either Resend OR SMTP. In dev, emails are
# printed to stdout if neither is set (StdoutDriver).
#
# Option A — Resend (default driver):
# RESEND_API_KEY=re_...
#
# Option B — SMTP:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-pass
#
# Sender address (required in production):
# EMAIL_FROM=My App <noreply@example.com>

# --- Public URL (M1) -----------------------------------------------------------
# Where this deployment is reachable. Required in production; dev falls back
# to http://localhost:$PORT. Magic-link emails and stored file URLs use it.
# BETTER_AUTH_URL=https://raze.example.com

# --- Storage (M1-2) -------------------------------------------------------------
# `local` (default): files under STORAGE_LOCAL_DIR, served at /files/<key>.
# `s3`: AWS S3 or any S3-compatible endpoint (R2, MinIO). Bucket can stay
# private — reads go through short-lived presigned URLs.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./data/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for R2/MinIO-style endpoints

# --- Billing (M3 / ADR 0004) -----------------------------------------------------
# free (default): free-tier caps for every non-BYOK user, no paid tiers.
#                 Safe soft-launch default — your API bill can't be drained.
# none:           self-host mode — everything unlocked, no metering.
# lemonsqueezy:   full subscription billing via Lemon Squeezy webhooks.
BILLING_PROVIDER=free
# Required for lemonsqueezy mode (from your LS webhook settings):
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Hosted checkout links for the upgrade buttons. Append checkout[custom][user_id]
# at runtime — the app does this automatically from these base URLs:
# LEMONSQUEEZY_CHECKOUT_PLUS=https://your-store.lemonsqueezy.com/buy/...
# LEMONSQUEEZY_CHECKOUT_PRO=https://your-store.lemonsqueezy.com/buy/...
# Optional explicit variant-id -> plan mapping (else falls back to name match):
# LEMONSQUEEZY_VARIANT_PLUS=
# LEMONSQUEEZY_VARIANT_PRO=

# --- Web Push (M4-4) -------------------------------------------------------------
# Generate once: npx web-push generate-vapid-keys
# Without these, push stays dormant (no UI toggle, no scheduler).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Couple-photo model (any fal endpoint accepting { prompt, image_urls }):
# FAL_COUPLE_MODEL=fal-ai/nano-banana/edit

# --- Operator-managed AI provider keys (Phase 1b-i / ADR 0002) ----------------
# These are the keys used to serve free/subscription-tier users (the default).
# Users who opt into BYOK in Settings shadow these on a per-key basis and
# bypass the daily free-tier meters (shared/quotas.ts).
#
#   OPERATOR_OPENROUTER_KEY — required for chat to work at all
#   OPERATOR_FAL_KEY        — selfie generation (camera button disabled without it)
#   OPERATOR_OPENAI_KEY     — Whisper voice transcription
#   OPERATOR_ELEVENLABS_KEY / OPERATOR_FISH_AUDIO_KEY — premium TTS voices
OPERATOR_OPENROUTER_KEY=
# Optional official DeepSeek key for self-hosted mode
OPERATOR_DEEPSEEK_KEY=
OPERATOR_FAL_KEY=
OPERATOR_ELEVENLABS_KEY=
OPERATOR_FISH_AUDIO_KEY=
OPERATOR_OPENAI_KEY=
